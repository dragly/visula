struct Fields {
    a: vec3<f32>,
}

@vertex 
fn vs_main(@location(0) value: f32) -> @builtin(position) vec4<f32> {
    var fields: Fields;

    let _visula_shared: f32 = (value * 2f);
    let _visula_shared_1: f32 = (cos(_visula_shared) + _visula_shared);
    fields.a = vec3<f32>(sin(_visula_shared_1), cos(_visula_shared_1), _visula_shared);
    let output: Fields = fields;
    return vec4(0f);
}
