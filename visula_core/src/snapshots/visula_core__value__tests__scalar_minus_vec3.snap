---
source: visula_core/src/value.rs
expression: wgsl
---
struct Fields {
    a: vec3<f32>,
}

struct BackgroundUniform {
    color: vec3<f32>,
    _padding: f32,
}

@group(1) @binding(0) 
var<uniform> background: BackgroundUniform;

@vertex 
fn vs_main() -> @builtin(position) vec4<f32> {
    var fields: Fields;

    fields.a = mix(background.color, (vec3(1f) - background.color), 0.15f);
    let output: Fields = fields;
    return vec4(0f);
}
