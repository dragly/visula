---
source: visula_core/src/value.rs
expression: wgsl
---
struct Fields {
    a: vec3<f32>,
}

@vertex 
fn vs_main(@location(0) value: f32) -> @builtin(position) vec4<f32> {
    var fields: Fields;

    fields.a = vec3<f32>(cos(value), sin(value), value);
    let output: Fields = fields;
    return vec4(0f);
}
