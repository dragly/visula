---
source: visula_core/src/value.rs
expression: wgsl
---
struct Fields {
    a: vec3<f32>,
    b: vec3<f32>,
    c: vec3<f32>,
    d: vec3<f32>,
    e: vec3<f32>,
}

struct BackgroundUniform {
    color: vec3<f32>,
    _padding: f32,
}

@group(1) @binding(0) 
var<uniform> background: BackgroundUniform;

@vertex 
fn vs_main() -> @builtin(position) vec4<f32> {
    var fields: Fields;

    fields.a = (background.color + vec3(0.5f));
    fields.b = (background.color - vec3(0.5f));
    fields.c = (2f * background.color);
    fields.d = (vec3(2f) / background.color);
    fields.e = (background.color % vec3(2f));
    let output: Fields = fields;
    return vec4(0f);
}
