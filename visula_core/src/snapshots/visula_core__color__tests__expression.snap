---
source: visula_core/src/color.rs
expression: wgsl
---
struct Fields {
    a: vec3<f32>,
}

@fragment 
fn fs_main(@location(0) @interpolate(flat) value: f32) -> @location(0) vec4<f32> {
    var fields: Fields;

    let srgb: vec3<f32> = vec3<f32>(value, 0.5f, 1f);
    fields.a = mix((srgb / vec3(12.92f)), pow(((srgb + vec3(0.055f)) / vec3(1.055f)), vec3<f32>(2.4f, 2.4f, 2.4f)), step(vec3<f32>(0.04045f, 0.04045f, 0.04045f), srgb));
    let output: Fields = fields;
    return vec4(0f);
}
